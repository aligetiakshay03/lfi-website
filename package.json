{
  "name": "tina-self-hosted-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx --yes -p node@20 node ./node_modules/@tinacms/cli/bin/tinacms dev -c \"next dev\"",
    "dev:prod": "npx --yes -p node@20 node ./node_modules/@tinacms/cli/bin/tinacms dev -c \"next dev\"",
    "build": "npx --yes -p node@20 node ./node_modules/@tinacms/cli/bin/tinacms build -c \"next build\"",
    "postbuild": "node sitemap.js",
    "start": "npx --yes -p node@20 node ./node_modules/next/dist/bin/next start",
    "start:cms": "npx --yes -p node@20 node ./node_modules/@tinacms/cli/bin/tinacms dev -c \"next start\"",
    "lint": "npx --yes -p node@20 node ./node_modules/next/dist/bin/next lint",
    "email-dev": "email dev --dir components/emails"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/react": "18.2.7",
    "@types/react-dom": "18.2.4",
