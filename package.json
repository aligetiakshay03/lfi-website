    "@react-email/render": "^0.0.12",
    "@tinacms/auth": "^1.0.6",
    "@tinacms/cli": "^1.9.6",
    "@tinacms/datalayer": "^1.2.39",
    "@types/react-gtm-module": "^2.0.3",
    "@udecode/plate": "^48.0.5",
    "all": "^0.0.0",
    "antd": "^5.18.0",
    "aws-sdk": "^2.1549.0",
    "gsap": "^3.15.0",
    "jotai": "^2.20.3",
    "mongodb-level": "^0.0.4",
    "next": "^14.2.3",
    "next-auth": "^4.24.5",
    "next-tinacms-s3": "^4.0.0",
    "npm": "^10.8.1",
    "react": "18.2.0",
